DownloadProductionBuildSource () {
# Downloads list of official production builds
	local CHANNELURL="$1"
	local BUILDSFILE="$SCRATCH_AREA/builds.txt"
	PRODBUILDS=()
	if ! curl "${CURL_ARGS[@]}" --output "$SCRATCH_AREA/builds.txt" "${CHANNELURL}builds.txt"; then
		echo "$(cecho "$yellow" "Warning: failed to download build list from ${CHANNELURL}builds.txt; continuing without delta filtering")" >&2
		PRODBUILDS=()
		return 0
	fi
	IFS=$'\n' read -d '' -r -a PRODBUILDS < "$BUILDSFILE"
	if [[ "$PRODBUILDS[0]" == "1"* ]]; then
		return 0
	else
		PRODBUILDS=()
		return 0
	fi
}

ArchiveCollateralFiles () {
# Archives collateral files in the cache folder
	local APPID="$1"
	if [ "$NOCOLLATERAL" = true ]; then
		return 0
	fi
	if [ ! -d "$CACHEPATH/collateral" ]; then
		mkdir "$CACHEPATH/collateral"
	fi
	local APPVER=$(GetAppVersionFromXML "$APPID")
	if [ ! -d "$CACHEPATH/collateral/$APPVER" ]; then
		mkdir "$CACHEPATH/collateral/$APPVER"
	fi
	for REQUIRED_FILE in "$APPID-chk.xml" "$APPID.xml" "$APPID.cat"; do
		if [ ! -f "$SCRATCH_AREA/$REQUIRED_FILE" ]; then
			cecho "$yellow" "Warning: missing collateral file $REQUIRED_FILE for $APPID; skipping archive" >&2
			continue
		fi
		cp "$SCRATCH_AREA/$REQUIRED_FILE" "$CACHEPATH/collateral/$APPVER"
	done
	if [ -f "$CACHEPATH/collateral/$APPVER/$APPID-chk.xml" ]; then
		# Disable versioned manifests
		# NOTE: The following command will only work on macOS
		/usr/libexec/PlistBuddy -c "Set :VersionedManifests bool false" "$CACHEPATH/collateral/$APPVER/$APPID-chk.xml" >/dev/null 2>&1 || true
	fi
}

BuildPackageListFromManifest () {
# Identifies active packages for an app and appends them to the shared in-memory package list
	APPID="$1"
	CURRENT_PACKAGE_START_INDEX=$PACKAGE_COUNT
	APPNAME=$(GetAppNameFromMAUID "$APPID")
	LOCATION=()
	MANIFEST_FILE="$SCRATCH_AREA/$APPID.xml"
	if [ ! -f "$MANIFEST_FILE" ]; then
		notice_body="Warning: manifest file not found for $APPID; skipping package build"
		cecho "$yellow" "$notice_body" >&2
		return 0
	fi

	if [ "$APPID" == "0409MSOF14" ] || [ "$APPID" == "0409UCCP14" ]; then
		LOCATION=($(cd "$SCRATCH_AREA" 2>/dev/null && { grep -o 'http[^"]*dmg' "$APPID.xml" 2>/dev/null || true; } | sort | uniq))
	else
		LOCATION=($(cd "$SCRATCH_AREA" 2>/dev/null && { grep -o 'http[^"]*pkg' "$APPID.xml" 2>/dev/null || true; } | sort | uniq))
	fi

	BUILDTIMESTAMP=$(GetBuildTimestampFromXML "$APPID")

	for i in "${LOCATION[@]}"
	do
		SKIPDOWNLOAD=false
		PACKAGENAME=$(basename "$i")
		if [[ $PACKAGENAME == *"Delta"* ]]; then
			if [ "${#PRODBUILDS[@]}" -gt 0 ]; then
				for PRODVER in "${PRODBUILDS[@]}"
				do
					if [[ $PACKAGENAME == *"$PRODVER""_to_"* ]]; then
						SKIPDOWNLOAD=false
						break
					else
						SKIPDOWNLOAD=true
					fi
				done
			else
				SKIPDOWNLOAD=false
			fi
		fi

		if [ "$SKIPDOWNLOAD" == false ]; then
			PACKAGEURL=$(ResolveDownloadUrl "$i")
			PACKAGESIZECDN=$(GetDownloadSize "$i")
			if [[ "$PACKAGESIZECDN" =~ ^[0-9]+$ ]]; then
				PACKAGESIZECDNMEG=$((PACKAGESIZECDN / 1024 / 1024))
			else
				PACKAGESIZECDNMEG=0
			fi

			PACKAGE_NAME_LIST[$PACKAGE_COUNT]="$PACKAGENAME"
			PACKAGE_URL_LIST[$PACKAGE_COUNT]="$PACKAGEURL"
			PACKAGE_SIZE_LIST[$PACKAGE_COUNT]="$PACKAGESIZECDN"
			PACKAGE_SIZE_MEG_LIST[$PACKAGE_COUNT]="$PACKAGESIZECDNMEG"
			PACKAGE_TIMESTAMP_LIST[$PACKAGE_COUNT]="$BUILDTIMESTAMP"
			PACKAGE_APPNAME_LIST[$PACKAGE_COUNT]="$APPNAME"
			PACKAGE_COUNT=$((PACKAGE_COUNT + 1))
		fi
	done
}

CountExistingPackages () {
# Counts packages already present locally without changing cache state
	for ((idx=0; idx<PACKAGE_COUNT; idx++))
	do
		PACKAGENAME="${PACKAGE_NAME_LIST[$idx]}"
		PACKAGESIZECDN="${PACKAGE_SIZE_LIST[$idx]}"
		if [ -f "$CACHEPATH/$PACKAGENAME" ]; then
			PACKAGESIZELOCAL=$(GetLocalSize "$PACKAGENAME")
			if [ "$PACKAGESIZELOCAL" == "$PACKAGESIZECDN" ]; then
				ACTIVE_EXISTING_COUNT=$((ACTIVE_EXISTING_COUNT + 1))
				ACTIVE_EXISTING_BYTES=$((ACTIVE_EXISTING_BYTES + PACKAGESIZELOCAL))
			fi
		fi
	done
}

CheckCachedPackages () {
# Refreshes mtimes and removes corrupt cached packages from the shared in-memory package list
	for ((idx=0; idx<PACKAGE_COUNT; idx++))
	do
		PACKAGENAME="${PACKAGE_NAME_LIST[$idx]}"
		PACKAGESIZECDN="${PACKAGE_SIZE_LIST[$idx]}"
		if [ -f "$CACHEPATH/$PACKAGENAME" ]; then
			PACKAGESIZELOCAL=$(GetLocalSize "$PACKAGENAME")
			if [ "$PACKAGESIZELOCAL" == "$PACKAGESIZECDN" ]; then
				touch -c -m "$CACHEPATH/$PACKAGENAME"
				echo Package "$PACKAGENAME" already exists in the cache ...updating timestamp
			else
				echo Package "$PACKAGENAME" exists in the cache but is corrupt ...removing
				rm -f "$CACHEPATH/$PACKAGENAME"
				APPNAME="${PACKAGE_APPNAME_LIST[$idx]}"
				PACKAGEURL="${PACKAGE_URL_LIST[$idx]}"
				PACKAGESIZECDNMEG="${PACKAGE_SIZE_MEG_LIST[$idx]}"
				BUILDTIMESTAMP="${PACKAGE_TIMESTAMP_LIST[$idx]}"
				if [ -n "$PACKAGEURL" ]; then
					MISSING_DOWNLOAD_COUNT=$((MISSING_DOWNLOAD_COUNT + 1))
					MISSING_DOWNLOAD_BYTES=$((MISSING_DOWNLOAD_BYTES + PACKAGESIZECDN))
					QueueDownloadPlanEntry "$APPNAME" "$PACKAGEURL" "$PACKAGESIZECDNMEG" "$BUILDTIMESTAMP"
				fi
			fi
		fi
	done
}

BuildDownloadPlan () {
# Counts, sizes, and queues packages that are not present locally
	APPNAME="$1"
	local PACKAGE_START_INDEX="$2"
	for ((idx=PACKAGE_START_INDEX; idx<PACKAGE_COUNT; idx++))
	do
		PACKAGENAME="${PACKAGE_NAME_LIST[$idx]}"
		PACKAGESIZECDN="${PACKAGE_SIZE_LIST[$idx]}"
		PACKAGEURL="${PACKAGE_URL_LIST[$idx]}"
		PACKAGESIZECDNMEG="${PACKAGE_SIZE_MEG_LIST[$idx]}"
		BUILDTIMESTAMP="${PACKAGE_TIMESTAMP_LIST[$idx]}"
		if [ ! -f "$CACHEPATH/$PACKAGENAME" ]; then
			MISSING_DOWNLOAD_COUNT=$((MISSING_DOWNLOAD_COUNT + 1))
			MISSING_DOWNLOAD_BYTES=$((MISSING_DOWNLOAD_BYTES + PACKAGESIZECDN))
			QueueDownloadPlanEntry "$APPNAME" "$PACKAGEURL" "$PACKAGESIZECDNMEG" "$BUILDTIMESTAMP"
		fi
	done
}

GetAppVersionFromXML () {
# Returns the current app version from the XML collateral
	XML="$1"".xml"
	local APPVER
	APPVER=$(cd "$SCRATCH_AREA" 2>/dev/null && grep -A1 -m2 'Update Version' "$XML" 2>/dev/null | grep 'string' 2>/dev/null | sed -e 's,.*<string>\([^<]*\)</string>.*,\1,g' | tail -1 || true)
	if [ -z "$APPVER" ]; then
		echo "Legacy"
	else
		echo "$APPVER"
	fi
}

GetBuildTimestampFromXML () {
# Returns the build timestamp from the XML collateral in UTC ISO 8601 format
	XML="$1"".xml"
	local BUILDTIMESTAMP
	BUILDTIMESTAMP=$(cd "$SCRATCH_AREA" 2>/dev/null && grep -A1 'Date' "$XML" 2>/dev/null | grep 'date' 2>/dev/null | sed -e 's,.*<date>\([^<]*\)</date>.*,\1,g' | tail -1 || true)
	echo "$BUILDTIMESTAMP"
}

SetPackageFileTimes () {
# Applies the XML build timestamp to the downloaded package
	local FILENAME="$1"
	local BUILDTIMESTAMP="$2"

	if [ -z "$BUILDTIMESTAMP" ] || [ ! -f "$CACHEPATH/$FILENAME" ]; then
		return
	fi

	if [ "$PLATFORM" == "Darwin" ]; then
		local TOUCHSTAMP=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$BUILDTIMESTAMP" "+%Y%m%d%H%M.%S" 2>/dev/null)
		if [ -n "$TOUCHSTAMP" ]; then
			touch -t "$TOUCHSTAMP" "$CACHEPATH/$FILENAME"
		fi

		if command -v SetFile >/dev/null 2>&1; then
			local CREATESTAMP=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$BUILDTIMESTAMP" "+%m/%d/%Y %H:%M:%S" 2>/dev/null)
			if [ -n "$CREATESTAMP" ]; then
				SetFile -d "$CREATESTAMP" "$CACHEPATH/$FILENAME"
			fi
		fi
	else
		TZ=UTC touch -d "$BUILDTIMESTAMP" "$CACHEPATH/$FILENAME" 2>/dev/null
	fi
}

