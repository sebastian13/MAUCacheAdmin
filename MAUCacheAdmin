CleanupOnInterrupt () {
# Cleans up temporary state when the script is interrupted
	echo
	echo "Interrupted by user. Cleaning up temporary files..."
	if [ -d "$SCRATCH_AREA" ]; then
		rm -rf "$SCRATCH_AREA" 2>/dev/null
	fi
	for DOWNLOADED_FILE in "${DOWNLOADED_FILES_LIST[@]}"
	do
		[ -n "$DOWNLOADED_FILE" ] && rm -f "$CACHEPATH/$DOWNLOADED_FILE" 2>/dev/null
	done
	exit 130
}

