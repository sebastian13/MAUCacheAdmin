QueueDownloadPlanEntry () {
# Adds a package to the in-memory download queue
	local APPNAME="$1"
	local PACKAGEURL="$2"
	local PACKAGESIZECDNMEG="$3"
	local BUILDTIMESTAMP="$4"
	DOWNLOAD_APPNAME_LIST[$DOWNLOAD_COUNT]="$APPNAME"
	DOWNLOAD_URL_LIST[$DOWNLOAD_COUNT]="$PACKAGEURL"
	DOWNLOAD_SIZE_LIST[$DOWNLOAD_COUNT]="$PACKAGESIZECDNMEG"
	DOWNLOAD_TIMESTAMP_LIST[$DOWNLOAD_COUNT]="$BUILDTIMESTAMP"
	DOWNLOAD_COUNT=$((DOWNLOAD_COUNT + 1))
}

RunDownloadPlan () {
# Executes queued downloads after cleanup
	for ((idx=0; idx<DOWNLOAD_COUNT; idx++))
	do
		APPNAME="${DOWNLOAD_APPNAME_LIST[$idx]}"
		PACKAGEURL="${DOWNLOAD_URL_LIST[$idx]}"
		PACKAGESIZECDNMEG="${DOWNLOAD_SIZE_LIST[$idx]}"
		BUILDTIMESTAMP="${DOWNLOAD_TIMESTAMP_LIST[$idx]}"
		[ -z "$PACKAGEURL" ] && continue
		PACKAGENAME=$(basename "$PACKAGEURL")
		if [ ! -f "$CACHEPATH/$PACKAGENAME" ]; then
			if ! DownloadPackage "$PACKAGEURL" "$APPNAME" "$PACKAGESIZECDNMEG" "$BUILDTIMESTAMP"; then
				cecho "$yellow" "Warning: download failed for $PACKAGENAME; continuing with next package" >&2
			fi
		fi
	done
}

GetFileSizeByPath () {
# Gets the size of a file from an absolute path
	local FILEPATH="$1"
	if [ ! -f "$FILEPATH" ]; then
		echo "0"
		return 0
	fi
	if [ "$PLATFORM" == "Darwin" ]; then
		stat -qf%z "$FILEPATH"
	else
		stat -c%s "$FILEPATH"
	fi
}

GetFreeSpaceBytes () {
# Returns free bytes for the filesystem that hosts CACHEPATH
	df -kP "$CACHEPATH" | awk 'NR==2 {print $4 * 1024}'
}

GetTotalSpaceBytes () {
# Returns total bytes for the filesystem that hosts CACHEPATH
	df -kP "$CACHEPATH" | awk 'NR==2 {print $2 * 1024}'
}

GetFreeSpacePercent () {
# Returns percentage of free space for the filesystem that hosts CACHEPATH
	local FREE_BYTES="$1"
	local TOTAL_BYTES
	TOTAL_BYTES=$(GetTotalSpaceBytes)
	if [ "$TOTAL_BYTES" -le 0 ]; then
		echo "0.00"
		return 0
	fi
	awk -v free="$FREE_BYTES" -v total="$TOTAL_BYTES" 'BEGIN {printf "%.2f", (free / total) * 100}'
}

FormatBytesToGB () {
# Formats bytes to GiB with two decimals
	local BYTES="$1"
	awk -v b="$BYTES" 'BEGIN {printf "%.2f", b / 1024 / 1024 / 1024}'
}

CalculateCleanupCandidates () {
# Calculates the oldest outdated files needed to restore free-space above the configured threshold.
	CLEANUP_CANDIDATE_BYTES=0
	CLEANUP_CANDIDATE_COUNT=0

	if [ "$CLEANUP" != true ]; then
		return
	fi

	FREE_SPACE_CURRENT_BYTES=$(GetFreeSpaceBytes)
	FREE_SPACE_PROJECTED_BYTES=$((FREE_SPACE_CURRENT_BYTES - MISSING_DOWNLOAD_BYTES))

	local TOTAL_BYTES FREE_THRESHOLD_BYTES REQUIRED_BYTES
	TOTAL_BYTES=$(GetTotalSpaceBytes)
	if [ "$TOTAL_BYTES" -le 0 ]; then
		return
	fi
	FREE_THRESHOLD_BYTES=$((TOTAL_BYTES * CLEANUP_PERCENT / 100))

	if [ "$FREE_SPACE_CURRENT_BYTES" -ge "$FREE_THRESHOLD_BYTES" ] && [ "$FREE_SPACE_PROJECTED_BYTES" -ge "$FREE_THRESHOLD_BYTES" ]; then
		while IFS= read -r -d '' FILEPATH
		do
			FILESIZE=$(GetFileSizeByPath "$FILEPATH")
			CLEANUP_CANDIDATE_BYTES=$((CLEANUP_CANDIDATE_BYTES + FILESIZE))
			CLEANUP_CANDIDATE_COUNT=$((CLEANUP_CANDIDATE_COUNT + 1))
		done < <(find "$CACHEPATH" -type f -mtime +"$CLEANUP_DAYS" -print0)
		return
	fi

	REQUIRED_BYTES=0
	if [ "$FREE_SPACE_CURRENT_BYTES" -lt "$FREE_THRESHOLD_BYTES" ]; then
		REQUIRED_BYTES=$((FREE_THRESHOLD_BYTES - FREE_SPACE_CURRENT_BYTES))
	fi
	if [ "$FREE_SPACE_PROJECTED_BYTES" -lt "$FREE_THRESHOLD_BYTES" ]; then
		local PROJECTED_DEFICIT=$((FREE_THRESHOLD_BYTES - FREE_SPACE_PROJECTED_BYTES))
		if [ "$PROJECTED_DEFICIT" -gt "$REQUIRED_BYTES" ]; then
			REQUIRED_BYTES="$PROJECTED_DEFICIT"
		fi
	fi

	local -A CURRENT_PACKAGE_NAMES=()
	for ((idx=0; idx<PACKAGE_COUNT; idx++))
	do
		CURRENT_PACKAGE_NAMES["${PACKAGE_NAME_LIST[$idx]}"]=1
	done

	local FILEPATH FILENAME FILESIZE
	while IFS=$'\t' read -r FILEMTIME FILEPATH; do
		[ -n "$FILEPATH" ] || continue
		FILENAME="${FILEPATH##*/}"
		case "$FILENAME" in
			*.part|*.xml|*.cat|*.txt)
				continue
				;;
		esac
		if [[ -n "${CURRENT_PACKAGE_NAMES[$FILENAME]:-}" ]]; then
			continue
		fi
		FILESIZE=$(GetFileSizeByPath "$FILEPATH")
		if [ "$FILESIZE" -le 0 ]; then
			continue
		fi
		CLEANUP_CANDIDATE_BYTES=$((CLEANUP_CANDIDATE_BYTES + FILESIZE))
		CLEANUP_CANDIDATE_COUNT=$((CLEANUP_CANDIDATE_COUNT + 1))
		if [ "$CLEANUP_CANDIDATE_BYTES" -ge "$REQUIRED_BYTES" ]; then
			break
		fi
	done < <(BuildOutdatedFileList | sort -n)
}

GetFileMTimeEpoch () {
# Returns a file's modification time in Unix epoch seconds
	local FILEPATH="$1"
	if [ ! -f "$FILEPATH" ]; then
		echo "0"
		return 0
	fi
	if [ "$PLATFORM" == "Darwin" ]; then
		stat -f %m "$FILEPATH"
	else
		stat -c %Y "$FILEPATH"
	fi
}

BuildOutdatedFileList () {
# Builds a sorted list of outdated cache files, oldest first, excluding current manifest entries
	local -A CURRENT_PACKAGE_NAMES=()
	for ((idx=0; idx<PACKAGE_COUNT; idx++))
	do
		CURRENT_PACKAGE_NAMES["${PACKAGE_NAME_LIST[$idx]}"]=1
	done

	while IFS= read -r FILEPATH; do
		FILENAME="${FILEPATH##*/}"
		case "$FILENAME" in
			*.part|*.xml|*.cat|*.txt)
				continue
				;;
		esac
		if [[ -n "${CURRENT_PACKAGE_NAMES[$FILENAME]:-}" ]]; then
			continue
		fi
		FILEMTIME=$(GetFileMTimeEpoch "$FILEPATH")
		if [ -n "$FILEMTIME" ] && [ "$FILEMTIME" -gt 0 ]; then
			printf '%s\t%s\n' "$FILEMTIME" "$FILEPATH"
		fi
	done < <(find "$CACHEPATH" -maxdepth 1 -type f -print)
}

CleanupOutdatedFilesByPercent () {
# Deletes the oldest outdated files only as long as needed to restore the free-space threshold
	if [ "$CLEANUP" != true ]; then
		return 0
	fi

	local TOTAL_BYTES FREE_THRESHOLD_BYTES
	TOTAL_BYTES=$(GetTotalSpaceBytes)
	if [ "$TOTAL_BYTES" -le 0 ]; then
		return 0
	fi
	FREE_THRESHOLD_BYTES=$((TOTAL_BYTES * CLEANUP_PERCENT / 100))

	FREE_SPACE_CURRENT_BYTES=$(GetFreeSpaceBytes)
	FREE_SPACE_PROJECTED_BYTES=$((FREE_SPACE_CURRENT_BYTES - MISSING_DOWNLOAD_BYTES))
	DebugLog "cleanup threshold check: current=${FREE_SPACE_CURRENT_BYTES} projected=${FREE_SPACE_PROJECTED_BYTES} threshold=${FREE_THRESHOLD_BYTES} total=${TOTAL_BYTES}"
	if [ "$FREE_SPACE_CURRENT_BYTES" -ge "$FREE_THRESHOLD_BYTES" ] && [ "$FREE_SPACE_PROJECTED_BYTES" -ge "$FREE_THRESHOLD_BYTES" ]; then
		DebugLog "cleanup skipped: free-space threshold already satisfied"
		return 0
	fi

	local BATCH_DATE=""
	local BATCH_FILES=()
	local BATCH_BYTES=0
	local FILEMTIME FILEDATE FILESIZE DELETED_THIS_BATCH=0
	local CURRENT_FILEPATH DELETE_FILEPATH
	while IFS=$'\t' read -r FILEMTIME CURRENT_FILEPATH; do
		[ -n "$CURRENT_FILEPATH" ] || continue
		FILEDATE=$(date -r "$FILEMTIME" +"%Y-%m-%d" 2>/dev/null || date -d "@$FILEMTIME" +"%Y-%m-%d" 2>/dev/null || echo "1970-01-01")

		if [ -n "$BATCH_DATE" ] && [ "$FILEDATE" != "$BATCH_DATE" ]; then
			DebugLog "batch boundary: date=${BATCH_DATE} files=${#BATCH_FILES[@]} bytes=${BATCH_BYTES} current=${FREE_SPACE_CURRENT_BYTES} projected=${FREE_SPACE_PROJECTED_BYTES} threshold=${FREE_THRESHOLD_BYTES}"
			if [ "$FREE_SPACE_CURRENT_BYTES" -lt "$FREE_THRESHOLD_BYTES" ] || [ "$FREE_SPACE_PROJECTED_BYTES" -lt "$FREE_THRESHOLD_BYTES" ]; then
				DELETED_THIS_BATCH=0
				for DELETE_FILEPATH in "${BATCH_FILES[@]}"; do
					[ -n "$DELETE_FILEPATH" ] || continue
					[ -f "$DELETE_FILEPATH" ] || continue
					FILESIZE=$(GetFileSizeByPath "$DELETE_FILEPATH")
					if [ "$FILESIZE" -le 0 ]; then
						continue
					fi
					rm -f "$DELETE_FILEPATH"
					FREE_SPACE_CURRENT_BYTES=$((FREE_SPACE_CURRENT_BYTES + FILESIZE))
					FREE_SPACE_PROJECTED_BYTES=$((FREE_SPACE_PROJECTED_BYTES + FILESIZE))
					DELETED_THIS_BATCH=$((DELETED_THIS_BATCH + 1))
					DebugLog "deleted one file: date=${BATCH_DATE} path=${DELETE_FILEPATH} size=${FILESIZE} current=${FREE_SPACE_CURRENT_BYTES} projected=${FREE_SPACE_PROJECTED_BYTES}"
					if [ "$FREE_SPACE_CURRENT_BYTES" -ge "$FREE_THRESHOLD_BYTES" ] && [ "$FREE_SPACE_PROJECTED_BYTES" -ge "$FREE_THRESHOLD_BYTES" ]; then
						break
					fi
				done
				if [ "$DELETED_THIS_BATCH" -gt 0 ]; then
					echo "Removed $DELETED_THIS_BATCH outdated files from $BATCH_DATE to restore free space above ${CLEANUP_PERCENT}%"
				fi
			else
				DebugLog "batch ${BATCH_DATE} not deleted because threshold is already restored"
			fi
			BATCH_FILES=()
			BATCH_DATE=""
			BATCH_BYTES=0
		fi

		if [ -z "$BATCH_DATE" ]; then
			BATCH_DATE="$FILEDATE"
		fi
		BATCH_FILES+=("$CURRENT_FILEPATH")
		FILESIZE=$(GetFileSizeByPath "$CURRENT_FILEPATH")
		if [ -f "$CURRENT_FILEPATH" ] && [ "$FILESIZE" -gt 0 ]; then
			BATCH_BYTES=$((BATCH_BYTES + FILESIZE))
		fi
		DebugLog "considered file: date=${FILEDATE} path=${CURRENT_FILEPATH} size=${FILESIZE} batch_bytes=${BATCH_BYTES}"

		if [ "$FREE_SPACE_CURRENT_BYTES" -ge "$FREE_THRESHOLD_BYTES" ] && [ "$FREE_SPACE_PROJECTED_BYTES" -ge "$FREE_THRESHOLD_BYTES" ]; then
			DebugLog "threshold restored; breaking loop"
			break
		fi
	done < <(BuildOutdatedFileList | sort -n)

	if [ -n "$BATCH_DATE" ] && [ "${#BATCH_FILES[@]}" -gt 0 ] && { [ "$FREE_SPACE_CURRENT_BYTES" -lt "$FREE_THRESHOLD_BYTES" ] || [ "$FREE_SPACE_PROJECTED_BYTES" -lt "$FREE_THRESHOLD_BYTES" ]; }; then
		DebugLog "final batch check: date=${BATCH_DATE} files=${#BATCH_FILES[@]} bytes=${BATCH_BYTES} current=${FREE_SPACE_CURRENT_BYTES} projected=${FREE_SPACE_PROJECTED_BYTES} threshold=${FREE_THRESHOLD_BYTES}"
		DELETED_THIS_BATCH=0
		for DELETE_FILEPATH in "${BATCH_FILES[@]}"; do
			[ -n "$DELETE_FILEPATH" ] || continue
			[ -f "$DELETE_FILEPATH" ] || continue
			FILESIZE=$(GetFileSizeByPath "$DELETE_FILEPATH")
			if [ "$FILESIZE" -le 0 ]; then
				continue
			fi
			rm -f "$DELETE_FILEPATH"
			FREE_SPACE_CURRENT_BYTES=$((FREE_SPACE_CURRENT_BYTES + FILESIZE))
			FREE_SPACE_PROJECTED_BYTES=$((FREE_SPACE_PROJECTED_BYTES + FILESIZE))
			DELETED_THIS_BATCH=$((DELETED_THIS_BATCH + 1))
			DebugLog "deleted remaining batch file: date=${BATCH_DATE} path=${DELETE_FILEPATH} size=${FILESIZE} current=${FREE_SPACE_CURRENT_BYTES} projected=${FREE_SPACE_PROJECTED_BYTES}"
			if [ "$FREE_SPACE_CURRENT_BYTES" -ge "$FREE_THRESHOLD_BYTES" ] && [ "$FREE_SPACE_PROJECTED_BYTES" -ge "$FREE_THRESHOLD_BYTES" ]; then
				break
			fi
		done
		if [ "$DELETED_THIS_BATCH" -gt 0 ]; then
			echo "Removed $DELETED_THIS_BATCH outdated files from $BATCH_DATE to restore free space above ${CLEANUP_PERCENT}%"
		fi
	fi

	CountOutdatedPackages
}

ShowCapacitySummary () {
# Shows capacity plan summary for this run
	FREE_SPACE_CURRENT_BYTES=$(GetFreeSpaceBytes)
	CalculateCleanupCandidates
	FREE_SPACE_PROJECTED_BYTES=$((FREE_SPACE_CURRENT_BYTES - MISSING_DOWNLOAD_BYTES + CLEANUP_CANDIDATE_BYTES))

	echo "----------------------------------------------------------------------------------------"
	echo "Capacity Summary"
	echo "Active existing:       $ACTIVE_EXISTING_COUNT files ($(FormatBytesToGB "$ACTIVE_EXISTING_BYTES") GiB)"
	echo "Outdated existing:     $OUTDATED_EXISTING_COUNT files ($(FormatBytesToGB "$OUTDATED_EXISTING_BYTES") GiB)"
	echo "To download:           $MISSING_DOWNLOAD_COUNT files ($(FormatBytesToGB "$MISSING_DOWNLOAD_BYTES") GiB)"
	echo "Cleanup candidates:    $CLEANUP_CANDIDATE_COUNT files ($(FormatBytesToGB "$CLEANUP_CANDIDATE_BYTES") GiB)" && if [ "$CLEANUP" != true ]; then echo "(Cleanup is disabled)"; fi
	echo "Free space now:        $(FormatBytesToGB "$FREE_SPACE_CURRENT_BYTES") GiB ($(GetFreeSpacePercent "$FREE_SPACE_CURRENT_BYTES")% free)"
	echo "Projected free space:  $(FormatBytesToGB "$FREE_SPACE_PROJECTED_BYTES") GiB ($(GetFreeSpacePercent "$FREE_SPACE_PROJECTED_BYTES")% free)"
	echo "----------------------------------------------------------------------------------------"
	echo
}

CleanupOldFiles () {
# Cleanup old cache and manifest files
	if [ "$CLEANUP" = true ]; then
		echo "Removing old files not modified within $CLEANUP_DAYS days..."
		find "$CACHEPATH" -type f -mtime +"$CLEANUP_DAYS" -print -delete
	fi
}

BuildApplicationArray () {
# Builds an array of all the MAU-enabled applications that we care about
	MAUAPP=()
	for APPID in "${MAUAPP_IDS[@]}"; do
		MAUAPP+=("${MAU_PREFIX}${APPID}")
	done
}

BuildCollateralArray () {
# Builds an array of MAU collateral file-paths which we'll use later for downloading XML and CAT files
	DOWNLOADARRAY=()
	for APPID in "${MAUAPP_IDS[@]}"; do
		DOWNLOADARRAY+=("$1${MAU_PREFIX}${APPID}")
	done
}

DownloadCollateralFiles () {
# Downloads XML/CAT collateral files
	for i in "$@"
	do
		echo Downloading collateral file: "$i"
		if ! curl "${CURL_ARGS[@]}" --output "$SCRATCH_AREA/$(basename "$i.xml")" "$i.xml"; then
			cecho "$yellow" "Warning: failed to download $i.xml" >&2
		fi
		if ! curl "${CURL_ARGS[@]}" --output "$SCRATCH_AREA/$(basename "$i.cat")" "$i.cat"; then
			cecho "$yellow" "Warning: failed to download $i.cat" >&2
		fi
		if ! curl "${CURL_ARGS[@]}" --output "$SCRATCH_AREA/$(basename "$i-chk.xml")" "$i-chk.xml"; then
			cecho "$yellow" "Warning: failed to download $i-chk.xml" >&2
		fi
	done
}

ArchiveCollateralFiles () {
# Archives collateral files in the cache folder
	local APPID="$1"
	if [ "$NOCOLLATERAL" = true ]; then
		return 0
	fi
	if [ ! -d "$CACHEPATH/collateral" ]; then
		mkdir "$CACHEPATH/collateral"
	fi
	local APPVER=$(GetAppVersionFromXML "$APPID")
	if [ ! -d "$CACHEPATH/collateral/$APPVER" ]; then
		mkdir "$CACHEPATH/collateral/$APPVER"
	fi
	for REQUIRED_FILE in "$APPID-chk.xml" "$APPID.xml" "$APPID.cat"; do
		if [ ! -f "$SCRATCH_AREA/$REQUIRED_FILE" ]; then
			cecho "$yellow" "Warning: missing collateral file $REQUIRED_FILE for $APPID; skipping archive" >&2
			continue
		fi
		cp "$SCRATCH_AREA/$REQUIRED_FILE" "$CACHEPATH/collateral/$APPVER"
	done
	if [ -f "$CACHEPATH/collateral/$APPVER/$APPID-chk.xml" ]; then
		# Disable versioned manifests
		# NOTE: The following command will only work on macOS
		/usr/libexec/PlistBuddy -c "Set :VersionedManifests bool false" "$CACHEPATH/collateral/$APPVER/$APPID-chk.xml" >/dev/null 2>&1 || true
	fi
}

BuildPackageListFromManifest () {
# Identifies active packages for an app and appends them to the shared in-memory package list
	APPID="$1"
	CURRENT_PACKAGE_START_INDEX=$PACKAGE_COUNT
	APPNAME="${MAU_APP_NAMES[${APPID#${MAU_PREFIX}}]:-${APPID#${MAU_PREFIX}}}"
	LOCATION=()
	MANIFEST_FILE="$SCRATCH_AREA/$APPID.xml"
	if [ ! -f "$MANIFEST_FILE" ]; then
		notice_body="Warning: manifest file not found for $APPID; skipping package build"
		cecho "$yellow" "$notice_body" >&2
		return 0
	fi

	if [ "$APPID" == "0409MSOF14" ] || [ "$APPID" == "0409UCCP14" ]; then
		LOCATION=($(cd "$SCRATCH_AREA" 2>/dev/null && { grep -o 'http[^"]*dmg' "$APPID.xml" 2>/dev/null || true; } | sort | uniq))
	else
		LOCATION=($(cd "$SCRATCH_AREA" 2>/dev/null && { grep -o 'http[^"]*pkg' "$APPID.xml" 2>/dev/null || true; } | sort | uniq))
	fi

	BUILDTIMESTAMP=$(GetBuildTimestampFromXML "$APPID")

	for i in "${LOCATION[@]}"
	do
		PACKAGENAME=$(basename "$i")
		PACKAGEURL="$i"
		PACKAGESIZECDN=$(GetDownloadSize "$i")
		if [[ "$PACKAGESIZECDN" =~ ^[0-9]+$ ]]; then
			PACKAGESIZECDNMEG=$((PACKAGESIZECDN / 1024 / 1024))
		else
			PACKAGESIZECDNMEG=0
		fi

		PACKAGE_NAME_LIST[$PACKAGE_COUNT]="$PACKAGENAME"
		PACKAGE_URL_LIST[$PACKAGE_COUNT]="$PACKAGEURL"
		PACKAGE_SIZE_LIST[$PACKAGE_COUNT]="$PACKAGESIZECDN"
		PACKAGE_SIZE_MEG_LIST[$PACKAGE_COUNT]="$PACKAGESIZECDNMEG"
		PACKAGE_TIMESTAMP_LIST[$PACKAGE_COUNT]="$BUILDTIMESTAMP"
		PACKAGE_APPNAME_LIST[$PACKAGE_COUNT]="$APPNAME"
		PACKAGE_COUNT=$((PACKAGE_COUNT + 1))
	done
}

CountExistingPackages () {
# Counts packages already present locally without changing cache state
	for ((idx=0; idx<PACKAGE_COUNT; idx++))
	do
		PACKAGENAME="${PACKAGE_NAME_LIST[$idx]}"
		PACKAGESIZECDN="${PACKAGE_SIZE_LIST[$idx]}"
		if [ -f "$CACHEPATH/$PACKAGENAME" ]; then
			PACKAGESIZELOCAL=$(GetLocalSize "$PACKAGENAME")
			if [ "$PACKAGESIZELOCAL" == "$PACKAGESIZECDN" ]; then
				ACTIVE_EXISTING_COUNT=$((ACTIVE_EXISTING_COUNT + 1))
				ACTIVE_EXISTING_BYTES=$((ACTIVE_EXISTING_BYTES + PACKAGESIZELOCAL))
			fi
		fi
	done
}

CountOutdatedPackages () {
# Counts cached package files that are no longer part of the current manifest set
	local -A CURRENT_PACKAGE_NAMES=()
	for ((idx=0; idx<PACKAGE_COUNT; idx++))
	do
		CURRENT_PACKAGE_NAMES["${PACKAGE_NAME_LIST[$idx]}"]=1
	done

	OUTDATED_EXISTING_COUNT=0
	OUTDATED_EXISTING_BYTES=0

	while IFS= read -r FILEPATH; do
		FILENAME="${FILEPATH##*/}"
		case "$FILENAME" in
			*.part|*.xml|*.cat|*.txt)
				continue
				;;
		esac
		if [[ -n "${CURRENT_PACKAGE_NAMES[$FILENAME]:-}" ]]; then
			continue
		fi
		FILESIZE=$(GetFileSizeByPath "$FILEPATH")
		if [ "$FILESIZE" -gt 0 ]; then
			OUTDATED_EXISTING_COUNT=$((OUTDATED_EXISTING_COUNT + 1))
			OUTDATED_EXISTING_BYTES=$((OUTDATED_EXISTING_BYTES + FILESIZE))
		fi
	done < <(find "$CACHEPATH" -maxdepth 1 -type f -print)
}

CheckCachedPackages () {
# Refreshes mtimes and removes corrupt cached packages from the shared in-memory package list
	for ((idx=0; idx<PACKAGE_COUNT; idx++))
	do
		PACKAGENAME="${PACKAGE_NAME_LIST[$idx]}"
		PACKAGESIZECDN="${PACKAGE_SIZE_LIST[$idx]}"
		if [ -f "$CACHEPATH/$PACKAGENAME" ]; then
			PACKAGESIZELOCAL=$(GetLocalSize "$PACKAGENAME")
			if [ "$PACKAGESIZELOCAL" == "$PACKAGESIZECDN" ]; then
				touch -c -m "$CACHEPATH/$PACKAGENAME"
				DebugLog "Package $PACKAGENAME already exists in the cache ...updating timestamp"
			else
				DebugLog "Package $PACKAGENAME exists in the cache but is corrupt ...removing"
				rm -f "$CACHEPATH/$PACKAGENAME"
				APPNAME="${PACKAGE_APPNAME_LIST[$idx]}"
				PACKAGEURL="${PACKAGE_URL_LIST[$idx]}"
				PACKAGESIZECDNMEG="${PACKAGE_SIZE_MEG_LIST[$idx]}"
				BUILDTIMESTAMP="${PACKAGE_TIMESTAMP_LIST[$idx]}"
				if [ -n "$PACKAGEURL" ]; then
					MISSING_DOWNLOAD_COUNT=$((MISSING_DOWNLOAD_COUNT + 1))
					MISSING_DOWNLOAD_BYTES=$((MISSING_DOWNLOAD_BYTES + PACKAGESIZECDN))
					QueueDownloadPlanEntry "$APPNAME" "$PACKAGEURL" "$PACKAGESIZECDNMEG" "$BUILDTIMESTAMP"
				fi
			fi
		fi
	done
}

BuildDownloadPlan () {
# Counts, sizes, and queues packages that are not present locally
	APPNAME="$1"
	local PACKAGE_START_INDEX="$2"
	for ((idx=PACKAGE_START_INDEX; idx<PACKAGE_COUNT; idx++))
	do
		PACKAGENAME="${PACKAGE_NAME_LIST[$idx]}"
		PACKAGESIZECDN="${PACKAGE_SIZE_LIST[$idx]}"
		PACKAGEURL="${PACKAGE_URL_LIST[$idx]}"
		PACKAGESIZECDNMEG="${PACKAGE_SIZE_MEG_LIST[$idx]}"
		BUILDTIMESTAMP="${PACKAGE_TIMESTAMP_LIST[$idx]}"
		if [ ! -f "$CACHEPATH/$PACKAGENAME" ]; then
			MISSING_DOWNLOAD_COUNT=$((MISSING_DOWNLOAD_COUNT + 1))
			MISSING_DOWNLOAD_BYTES=$((MISSING_DOWNLOAD_BYTES + PACKAGESIZECDN))
			QueueDownloadPlanEntry "$APPNAME" "$PACKAGEURL" "$PACKAGESIZECDNMEG" "$BUILDTIMESTAMP"
		fi
	done
}

GetAppVersionFromXML () {
# Returns the current app version from the XML collateral
	XML="$1"".xml"
	local APPVER
	APPVER=$(cd "$SCRATCH_AREA" 2>/dev/null && grep -A1 -m2 'Update Version' "$XML" 2>/dev/null | grep 'string' 2>/dev/null | sed -e 's,.*<string>\([^<]*\)</string>.*,\1,g' | tail -1 || true)
	if [ -z "$APPVER" ]; then
		echo "Legacy"
	else
		echo "$APPVER"
	fi
}

GetBuildTimestampFromXML () {
# Returns the build timestamp from the XML collateral in UTC ISO 8601 format
	XML="$1"".xml"
	local BUILDTIMESTAMP
	BUILDTIMESTAMP=$(cd "$SCRATCH_AREA" 2>/dev/null && grep -A1 'Date' "$XML" 2>/dev/null | grep 'date' 2>/dev/null | sed -e 's,.*<date>\([^<]*\)</date>.*,\1,g' | tail -1 || true)
	echo "$BUILDTIMESTAMP"
}

SetPackageFileTimes () {
# Applies the XML build timestamp to the downloaded package
	local FILENAME="$1"
	local BUILDTIMESTAMP="$2"

	if [ -z "$BUILDTIMESTAMP" ] || [ ! -f "$CACHEPATH/$FILENAME" ]; then
		return
	fi

	if [ "$PLATFORM" == "Darwin" ]; then
		local TOUCHSTAMP=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$BUILDTIMESTAMP" "+%Y%m%d%H%M.%S" 2>/dev/null)
		if [ -n "$TOUCHSTAMP" ]; then
			touch -t "$TOUCHSTAMP" "$CACHEPATH/$FILENAME"
		fi

		if command -v SetFile >/dev/null 2>&1; then
			local CREATESTAMP=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$BUILDTIMESTAMP" "+%m/%d/%Y %H:%M:%S" 2>/dev/null)
			if [ -n "$CREATESTAMP" ]; then
				SetFile -d "$CREATESTAMP" "$CACHEPATH/$FILENAME"
			fi
		fi
	else
		TZ=UTC touch -d "$BUILDTIMESTAMP" "$CACHEPATH/$FILENAME" 2>/dev/null
	fi
}

GetDownloadSize () {
# Gets the size of a file based on its header, then strips non-numeric characters
	URL="$1"
	local CONTENTHTTPLENGTH
	CONTENTHTTPLENGTH=$(curl --head -s --retry 2 --retry-delay 1 --connect-timeout 10 "$URL" 2>/dev/null | grep -i 'Content-Length:' | tail -1 | cut -d ' ' -f2 || true)
	CONTENTLENGTH=$(echo "${CONTENTHTTPLENGTH//[!0-9]/}")
	if [ -z "$CONTENTLENGTH" ]; then
		echo 0
		return 0
	fi
	echo "$CONTENTLENGTH"
}

GetLocalSize () {
# Gets the size of a file from the local disk
	local FILENAME="$1"
	# The stat command works differently between macOS and other Linux platforms like RHEL
	if [ "$PLATFORM" == "Darwin" ]; then
		local FILELENGTH=($(cd "$CACHEPATH" && stat -qf%z "$FILENAME"))
	else
		local FILELENGTH=($(cd "$CACHEPATH" && stat -c%s "$FILENAME"))
	fi
	echo $FILELENGTH
}

HipChatNotify () {
# Send Alert to HipChat Room Specified in Global Variable when Package is Downloaded
	if [ "$HIPCHAT_NOTIFY" = true ]; then
		echo "New Package Detected: $PACKAGE"
		curl -v -k -d "room_id=${HIPCHAT_ROOM_ID}&from=ServerAlert&message=""<b>MAU Server Alert</b> - New Package Downloaded:<b> ${PACKAGE}</b>""&color=purple" ${HIPCHAT_NOTIFY_ADDRESS}/message?auth_token=${HIPCHAT_AUTH_TOKEN}&format=json
	fi
}

SlackNotify () {
# Send Alert to Slack Webhook in Global Variable when Package is Downloaded
	if [ "$SLACK_NOTIFY" = true ]; then
		echo "New Package Detected: $PACKAGE"
		curl -X POST -H 'Content-type: application/json' --data '{"username":"MAUCacheAdmin","icon_url":"'"$SLACK_ICON_URL"'","text":"New Package Downloaded: '"$PACKAGE"'"}' $SLACK_WEBHOOK_URL
	fi
}

TeamsNotify () {
# Send Alert to Teams Webhook in Global Variable when Package is Downloaded
	if [ "$TEAMS_NOTIFY" = true ]; then
		echo "New Package Detected: $PACKAGE"
		curl -H 'Content-type: application/json' -d '{"text":"New Package Downloaded: '"$PACKAGE"'"}' $TEAMS_WEBHOOK_URL
	fi
}

DownloadPackage () {
# Downloads the specified update package
	URL="$1"
	APPLICATION="$2"
	SIZE="$3"
	BUILDTIMESTAMP="$4"
	PACKAGE=$(basename "$1")
	PARTFILE="$PACKAGE.part"
	if [ ! -f "$CACHEPATH/$PACKAGE" ] && [ ! -f "$CACHEPATH/$PARTFILE" ]; then
		DOWNLOADED_FILES_LIST+=("$PARTFILE")
	fi
	HipChatNotify
	SlackNotify
	TeamsNotify
	echo "==================================================="
	echo Application: "$APPLICATION"
	echo Package:     "$PACKAGE"
	echo Size:        "$SIZE" MB
	echo URL:         "$URL"
	if ! (cd "$CACHEPATH" && curl "${CURL_ARGS_PROGRESS[@]}" --output "$PARTFILE" "$URL"); then
		echo "Error: failed to download $PACKAGE from $URL" >&2
		rm -f "$CACHEPATH/$PARTFILE"
		return 1
	fi
	mv -f "$CACHEPATH/$PARTFILE" "$CACHEPATH/$PACKAGE"
	SetPackageFileTimes "$PACKAGE" "$BUILDTIMESTAMP"
}

ShowCollateral () {
# Shows collateral information of the downloaded collateral files
echo "----------------------------------------------------------------------------------------"
printf '%-14s %-42s %-11s %s\n' \
        "App ID" "Application" "Build Date" "[Folder]"
echo "----------------------------------------------------------------------------------------"

for d in "$CACHEPATH/collateral/"*;
do
  cd "$d/";
  if ls *.xml >/dev/null 2>&1; then
	  for XML in *.xml;
	  do
	  Folder=$(echo "$d" | awk -F "/" '{print $NF}')
	  if [ "$Folder" = "Legacy" ]; then
			AppIdentifier=$(echo "$XML" | sed -e 's/.xml//g')
			ver=""
			BuildDate=$(grep -A1 'Date' "$XML" | grep 'date' | sed -e 's,.*<date>\([^<]*\)</date>.*,\1,g' | tail -1 | cut -d"T" -f1)
			AppTitle=$(grep -A1 'Title' "$XML" | grep 'string' | sed -e 's,.*<string>\([^<]*\)</string>.*,\1,g' | tail -1)

			printf '%-14s %-42s %-11s %s\n' \
			"$AppIdentifier" "$AppTitle" "$BuildDate" "[$Folder]"
	  else
			AppIdentifier=$(echo "$XML" | sed -e 's/.xml//g')
			ver=$(grep -A1 -m2 'Update Version' "$XML" | grep 'string' | sed -e 's,.*<string>\([^<]*\)</string>.*,\1,g')
			BuildDate=$(grep -A1 'Date' "$XML" | grep 'date' | sed -e 's,.*<date>\([^<]*\)</date>.*,\1,g' | tail -1 | cut -d"T" -f1)
			AppTitle=$(grep -A1 'Title' "$XML" | grep 'string' | sed -e 's,.*<string>\([^<]*\)</string>.*,\1,g' | tail -1)

			printf '%-14s %-42s %-11s %s\n' \
			"$AppIdentifier" "$AppTitle" "$BuildDate" "[$Folder]"
	  fi
	  done
	else
		Folder=$(echo "$d" | awk -F "/" '{print $NF}')

		printf '%-14s %-42s %-11s %s\n' \
        "" "" "" "[$Folder]"
	fi
done
echo "----------------------------------------------------------------------------------------"
exit 0
}

CopyCollateral () {
# Copies collateral files from one folder to another.
	COPYCOLLATERALFROM=$(echo $COPYCOLLATERALFROM | sed 's/[][]//g')
	COPYCOLLATERALTO=$(echo $COPYCOLLATERALTO | sed 's/[][]//g')
	echo "Copying collateral files FROM:[$COPYCOLLATERALFROM] folder TO:[$COPYCOLLATERALTO] folder."
	cp "$CACHEPATH/collateral/$COPYCOLLATERALFROM/"* "$CACHEPATH/collateral/$COPYCOLLATERALTO/"
	exit 0
}


# Evaluate command-line arguments
if [[ $# = 0 ]]; then
	ShowUsage
else
	for KEY in "$@"
	do
	case $KEY in
		--Help|-h|--help)
			ShowUsage
			;;
		--CachePath:*|-c:*|--cachepath:*)
			CACHEPATH=${KEY#*:}
			;;
		--CheckInterval:*|-i:*|--checkinterval:*)
			CHECKINTERVAL=${KEY#*:}
			;;
		--CleanUp|-cu|--cleanup)
			CLEANUP=true
			;;
		--NoPackages|-np|--nopackages)
			NOPACKAGES=true
			;;
		--NoCollateral|-n|--nocollateral)
			NOCOLLATERAL=true
			;;
		--ShowCollateral|-sc|--showcollateral)
			ShowCollateral
			;;
		--CopyCollateralFrom:*|-ccf:*|--copycollateralfrom:*)
			COPYCOLLATERALFROM=${KEY#*:}
			;;
		--CopyCollateralTo:*|-cct:*|--copycollateralto:*)
			COPYCOLLATERALTO=${KEY#*:}
			CopyCollateral
			;;
		--InsiderSupport|-is|--insidersupport)
			INSIDER=true
			;;
		--Verbose|-v|--verbose)
			VERBOSE=true
			;;
		*)
			ShowUsage
			;;
	esac
	done
fi

## Main
while :
do
	# Get a clean area for writing temporary files
	InitializeScratchArea
	# Verify that the cache area is ready to go
	InitializeCacheArea
	# Initialize run metrics for capacity planning
	InitializeRunMetrics
	FREE_SPACE_START_BYTES=$(GetFreeSpaceBytes)
	# Build channel array
	CHANNELS[0]="$CHANNEL_COLLATERAL_PROD"
	if [ "$INSIDER" = true ]; then
		CHANNELS[1]="$CHANNEL_COLLATERAL_INSIDERSLOW"
		CHANNELS[2]="$CHANNEL_COLLATERAL_INSIDERFAST"
	fi

	# Phase 1: Download collateral files and build a download plan for missing packages
	for c in "${CHANNELS[@]}"
	do
		# Use the current Microsoft CDN URL directly
		COLLATERALURL="$c"
		# Build an array of the collateral files to download
		BuildCollateralArray "$COLLATERALURL"
		# Download collateral files for each application
		DownloadCollateralFiles "${DOWNLOADARRAY[@]}"
		# Build an array of all MAU-enabled applications
		echo "Building application array for channel: $c ..."
		BuildApplicationArray
		# Build an array of each package location and queue missing packages
		for a in "${MAUAPP[@]}"
		do
			ArchiveCollateralFiles "$a"
			if [ "$NOPACKAGES" != true ]; then
				APPNAME="${MAU_APP_NAMES[${a#${MAU_PREFIX}}]:-${a#${MAU_PREFIX}}}"
				echo "Building package list and download plan for $APPNAME ..."
				BuildPackageListFromManifest "$a"
				BuildDownloadPlan "$APPNAME" "$CURRENT_PACKAGE_START_INDEX"
			fi
		done
	done
	cecho $green "Building the download plan completed."
	echo

	# Phase 2: Count already cached packages before showing the summary
	if [ "$NOPACKAGES" != true ]; then
		CountExistingPackages
		CountOutdatedPackages
	fi

	# Show a summary and capacity plan before execution
	ShowCapacitySummary

	# Stop execution if space is insufficient for the planned downloads and cleanup
	if [ "$FREE_SPACE_PROJECTED_BYTES" -lt 0 ]; then
		cecho $RED "Error: Insufficient free space for planned downloads and cleanup."
		cecho $RED "Please free up space in the cache folder or adjust the cleanup retention period."
		exit 1
	fi

	# Phase 3: Check previously cached packages, refresh mtimes to avoid re-downloading, and remove corrupt files
	if [ "$NOPACKAGES" != true ]; then
		echo "Checking previously cached packages for validity and integrity:"
		echo "  This will refresh timestamps for valid packages and remove corrupt ones."
		echo "  Waiting 5 seconds before continuing. Press Ctrl+C to cancel..."
		sleep 5

		CheckCachedPackages

		cecho $green "Checking cached packages completed."
		echo "----------------------------------------------------------------------------------------"
		echo
	fi

	# Phase 4: Cleanup outdated files based on free-space pressure or retention age
	if [ "$CLEANUP" = true ]; then
		echo "Cleanup threshold check is enabled. Outdated files will be removed when free space falls below ${CLEANUP_PERCENT}% and the files are no longer in the current XML set."
		echo "  Waiting 5 seconds before cleanup execution. Press Ctrl+C to cancel..."
		sleep 5

		CleanupOutdatedFilesByPercent

		echo "Cleanup of old files is enabled. Files older than $CLEANUP_DAYS days will be removed."
		echo "  Waiting 5 seconds before cleanup execution. Press Ctrl+C to cancel..."
		sleep 5

		CleanupOldFiles

		cecho $green "Cleanup of old files completed."
		echo "----------------------------------------------------------------------------------------"
		echo
	fi
	
	# Phase 5: Download missing packages from the queued plan after cleanup
	if [ "$NOPACKAGES" != true ]; then
		echo "Starting download of missing packages."
		echo "  Total files to download: $MISSING_DOWNLOAD_COUNT"
		echo "  Total size to download:  $(FormatBytesToGB "$MISSING_DOWNLOAD_BYTES") GiB"
		echo "  Waiting 5 seconds before download execution. Press Ctrl+C to cancel..."
		sleep 5

		RunDownloadPlan

		cecho $green "Download of missing packages completed."
		echo "----------------------------------------------------------------------------------------"
		echo
	fi

	echo "Run completed. Cleaning up temporary files..."
	# Clean up temporary files in the scratch area
	CleanupScratchArea

	# If CheckInterval wasn't specified on the command-line, just run once
	if [ "$CHECKINTERVAL" == '' ]; then
		exit 0
	else
	# Otherwise, sleep for the specified number of minutes before checking again
		echo "Sleeping for $CHECKINTERVAL minutes..."
		CHECKINTERVALSECS=$(expr $CHECKINTERVAL \* 60)
		# Wait until the next check interval
		sleep "$CHECKINTERVALSECS"
	fi
done

exit 0
