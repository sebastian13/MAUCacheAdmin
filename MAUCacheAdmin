QueueDownloadPlanEntry () {
# Adds a package to the in-memory download queue
	local APPNAME="$1"
	local PACKAGEURL="$2"
	local PACKAGESIZECDNMEG="$3"
	local BUILDTIMESTAMP="$4"
	DOWNLOAD_APPNAME_LIST[$DOWNLOAD_COUNT]="$APPNAME"
	DOWNLOAD_URL_LIST[$DOWNLOAD_COUNT]="$PACKAGEURL"
	DOWNLOAD_SIZE_LIST[$DOWNLOAD_COUNT]="$PACKAGESIZECDNMEG"
	DOWNLOAD_TIMESTAMP_LIST[$DOWNLOAD_COUNT]="$BUILDTIMESTAMP"
	DOWNLOAD_COUNT=$((DOWNLOAD_COUNT + 1))
}

RunDownloadPlan () {
# Executes queued downloads after cleanup
	for ((idx=0; idx<DOWNLOAD_COUNT; idx++))
	do
		APPNAME="${DOWNLOAD_APPNAME_LIST[$idx]}"
		PACKAGEURL="${DOWNLOAD_URL_LIST[$idx]}"
		PACKAGESIZECDNMEG="${DOWNLOAD_SIZE_LIST[$idx]}"
		BUILDTIMESTAMP="${DOWNLOAD_TIMESTAMP_LIST[$idx]}"
		[ -z "$PACKAGEURL" ] && continue
		PACKAGENAME=$(basename "$PACKAGEURL")
		if [ ! -f "$CACHEPATH/$PACKAGENAME" ]; then
			if ! DownloadPackage "$PACKAGEURL" "$APPNAME" "$PACKAGESIZECDNMEG" "$BUILDTIMESTAMP"; then
				cecho "$yellow" "Warning: download failed for $PACKAGENAME; continuing with next package" >&2
			fi
		fi
	done
}

GetFileSizeByPath () {
# Gets the size of a file from an absolute path
	local FILEPATH="$1"
	if [ "$PLATFORM" == "Darwin" ]; then
		stat -qf%z "$FILEPATH"
	else
		stat -c%s "$FILEPATH"
	fi
}

GetFreeSpaceBytes () {
# Returns free bytes for the filesystem that hosts CACHEPATH
	df -kP "$CACHEPATH" | awk 'NR==2 {print $4 * 1024}'
}

FormatBytesToGB () {
# Formats bytes to GiB with two decimals
	local BYTES="$1"
	awk -v b="$BYTES" 'BEGIN {printf "%.2f", b / 1024 / 1024 / 1024}'
}

CalculateCleanupCandidates () {
# Calculates cleanup candidates based on configured retention
	CLEANUP_CANDIDATE_BYTES=0
	CLEANUP_CANDIDATE_COUNT=0

	if [ "$CLEANUP" != true ]; then
		return
	fi

	while IFS= read -r -d '' FILEPATH
	do
		FILESIZE=$(GetFileSizeByPath "$FILEPATH")
		CLEANUP_CANDIDATE_BYTES=$((CLEANUP_CANDIDATE_BYTES + FILESIZE))
		CLEANUP_CANDIDATE_COUNT=$((CLEANUP_CANDIDATE_COUNT + 1))
	done < <(find "$CACHEPATH" -type f -mtime +"$CLEANUP_DAYS" -print0)
}

ShowCapacitySummary () {
# Shows capacity plan summary for this run
	CalculateCleanupCandidates
	FREE_SPACE_CURRENT_BYTES=$(GetFreeSpaceBytes)
	FREE_SPACE_PROJECTED_BYTES=$((FREE_SPACE_START_BYTES - MISSING_DOWNLOAD_BYTES + CLEANUP_CANDIDATE_BYTES))

	echo "----------------------------------------------------------------------------------------"
	echo "Capacity Summary"
	echo "Active existing:       $ACTIVE_EXISTING_COUNT files ($(FormatBytesToGB "$ACTIVE_EXISTING_BYTES") GiB)"
	echo "To download:           $MISSING_DOWNLOAD_COUNT files ($(FormatBytesToGB "$MISSING_DOWNLOAD_BYTES") GiB)"
	echo "Cleanup candidates:    $CLEANUP_CANDIDATE_COUNT files ($(FormatBytesToGB "$CLEANUP_CANDIDATE_BYTES") GiB)"
	echo "Free space now:        $(FormatBytesToGB "$FREE_SPACE_CURRENT_BYTES") GiB"
	echo "Projected free space:  $(FormatBytesToGB "$FREE_SPACE_PROJECTED_BYTES") GiB"
	echo "----------------------------------------------------------------------------------------"
}

